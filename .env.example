# ---- encryption (REQUIRED) ----
# Generate with: npx dbbackup keygen   - store a copy in a password manager. Lost key = lost backups.
BACKUP_ENCRYPTION_KEY=
# Previous keys after a rotation (comma separated) so old backups stay restorable
BACKUP_OLD_KEYS=

# ---- databases ----
PG_URL=postgres://backup_user:change-me@localhost:5432/app
MONGO_URI=mongodb://backup_user:change-me@localhost:27017/app?authSource=admin
MYSQL_URL=mysql://backup_user:change-me@localhost:3306/crm

# ---- S3 / S3-compatible storage ----
S3_BUCKET=
AWS_REGION=eu-central-1
S3_PREFIX=backups
# Leave empty to use the default AWS credential chain (IAM role, ~/.aws, env)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Cloudflare R2: https://<account>.r2.cloudflarestorage.com  | Backblaze B2: https://s3.<region>.backblazeb2.com
# Wasabi: https://s3.<region>.wasabisys.com | MinIO: http://minio:9000 (+ "forcePathStyle": true)
S3_ENDPOINT=

# Second copy on a NAS / external disk / mounted share
LOCAL_BACKUP_DIR=./backups

# ---- alerts (any subset) ----
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Heartbeats (healthchecks.io / Uptime Kuma push / Better Stack): alert if a backup never ran
HC_PG_URL=
HC_MONGO_URL=
